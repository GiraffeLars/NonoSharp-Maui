<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:TypeArguments="system:Int32"
    x:Class="NonoSharp.Maui.DimensionsPopup">

    <VerticalStackLayout Spacing="6">
        <Label Text="Select the dimensions of the puzzle you wish to create"
               FontSize="24"
               HorizontalOptions="Center"/>
        <Button
            Text="5 × 5"
            Clicked="OnSize5ButtonClicked"/>

        <Button
            Text="10 × 10"
            Clicked="OnSize10ButtonClicked"/>


        <Button
            Text="15 × 15"
            Clicked="OnSize15ButtonClicked"/>

    </VerticalStackLayout>

</toolkit:Popup>